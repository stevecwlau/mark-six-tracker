rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for Bet Collection
    function isValidBet(bet) {
      return bet.keys().hasAll(['id', 'drawDate', 'numbers', 'type', 'importDate', 'source', 'userId'])
        && bet.id is string && bet.id.size() <= 128
        && bet.drawDate is string && bet.drawDate.size() == 10
        && bet.numbers is list && bet.numbers.size() <= 49
        && bet.type is string && (bet.type == 'single' || bet.type == 'multiple' || bet.type == 'banker')
        && bet.importDate is string && bet.importDate.size() <= 30
        && bet.source is string && (bet.source == 'manual' || bet.source == 'csv' || bet.source == 'excel' || bet.source == 'ocr')
        && bet.userId is string && bet.userId == request.auth.uid;
    }

    // Nest bets under /users/{userId}/bets/{betId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /bets/{betId} {
        allow read, list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(betId) 
          && isValidBet(incoming());
          
        allow update: if isOwner(userId) 
          && isValidBet(incoming()) 
          && incoming().id == existing().id
          && incoming().userId == existing().userId;

        allow delete: if isOwner(userId);
      }
    }
  }
}
